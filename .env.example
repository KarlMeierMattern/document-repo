# ============================================================
# Vercel (apps/web)
# ============================================================

# Neon Postgres pooled connection string
# Get from: https://console.neon.tech → your project → Connection Details → "Pooled connection"
DATABASE_URL=postgres://user:pass@host.neon.tech/dbname?sslmode=require

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URIs:
#   https://<your-vercel-domain>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single allowlisted email — only this Google account can sign in
OWNER_EMAIL=you@example.com

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=Documents <documents@yourdomain.com>

# Cloudflare R2 (https://dash.cloudflare.com → R2)
R2_ACCOUNT_ID=
R2_BUCKET=document-repo
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloud Run processor service
PROCESSOR_URL=https://processor-xxxxxxxx-uc.a.run.app/process
# Generate with: openssl rand -hex 32
PROCESSOR_SECRET=

# Vercel Cron — generate with: openssl rand -hex 32
CRON_SECRET=

# Anthropic (only required in apps/web if you want client-side reprocess control;
# the processor service is the primary caller)
# ANTHROPIC_API_KEY=

# ============================================================
# Cloud Run (services/processor) — set via Secret Manager in prod
# ============================================================
# DATABASE_URL=
# ANTHROPIC_API_KEY=
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# PROCESSOR_SECRET=
