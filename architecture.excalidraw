      "boundElements": [],
      "updated": 1778308787556,
      "link": null,
      "locked": false,
      "text": "Upload (1–2): browser presigns then PUTs directly to R2 — bytes never traverse Vercel.\nProcess (3–6): browser pings Vercel which kicks Cloud Run; processor downloads, calls Claude, persists to Neon.\nDigest: Vercel Cron 09:00 UTC reads pending reminders ≤30 days, sends a single Resend email.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "containerId": null,
      "originalText": "Upload (1–2): browser presigns then PUTs directly to R2 — bytes never traverse Vercel.\nProcess (3–6): browser pings Vercel which kicks Cloud Run; processor downloads, calls Claude, persists to Neon.\nDigest: Vercel Cron 09:00 UTC reads pending reminders ≤30 days, sends a single Resend email.",
      "lineHeight": 1.5,
      "index": "aZ",
      "autoResize": true
    }
  ],
